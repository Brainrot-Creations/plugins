{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "amc-theatres",
  "version": "1.0.0",
  "description": "AMC theatres, showtimes, and seat maps — via GraphQL with Chrome TLS bypass; optional AMC_COOKIE for gated routes.",
  "author": {
    "name": "Brainrot Creations",
    "email": "support@brainrotcreations.com",
    "url": "https://www.brainrotcreations.com"
  },
  "homepage": "https://www.amctheatres.com",
  "repository": "https://github.com/Brainrot-Creations/plugins",
  "license": "MIT",
  "keywords": [
    "movies",
    "showtimes"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "AMC Theatres",
        "shortDescription": "Find AMC theatres, showtimes and live seat maps.",
        "developerName": "Brainrot Creations",
        "category": "Lifestyle",
        "websiteURL": "https://www.amctheatres.com",
        "defaultPrompt": [
          "Use AMC Theatres to find showtimes near 10001 tonight."
        ],
        "brandColor": "#111111"
      }
    }
  }
}
